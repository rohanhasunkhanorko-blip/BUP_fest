# Copy this file to .env and fill in real values.
# .env is in .gitignore - never commit it.

# --- MongoDB Atlas (GridWise persistence) -----------------------------------
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_CLUSTER=your_cluster.xxxxx.mongodb.net
MONGODB_DB_NAME=gridwise

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-32-plus-char-random-string-before-production
API_KEY_TTL_DAYS=30

# --- LLM provider -----------------------------------------------------------
# Choose one of: openai | groq | local | ollama | openrouter | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q5_K_M

# --- Service ----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
